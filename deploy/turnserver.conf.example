# coturn configuration for Premiere Remote.
# Copy to turnserver.conf, then replace every value in <angle brackets>.

listening-port=3478
tls-listening-port=5349
# public IP of the VPS (and private IP if behind a cloud NAT: external-ip=<public>/<private>)
external-ip=<PUBLIC_IP>
realm=<turn.example.com>

# Time-limited credentials (TURN REST API). Must equal PR_TURN_SECRET in .env.
use-auth-secret
static-auth-secret=<LONG_RANDOM_SECRET>

# relay port range — open these UDP ports in the firewall
min-port=49160
max-port=49660

# TLS for turns: (helps on networks that block UDP). Point at Caddy's or certbot's certificate.
# cert=/etc/coturn/fullchain.pem
# pkey=/etc/coturn/privkey.pem

fingerprint
no-cli
no-multicast-peers
# never relay into private networks of the VPS
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
total-quota=20
user-quota=4
stale-nonce=600
no-stdout-log
log-file=stdout
simple-log
