# Copy to .env and fill in. Never commit the real .env.

# Public hostname of the signaling server (Caddy gets a TLS certificate for it)
PR_DOMAIN=signal.example.com

# Optional: require this key when a PC registers (recommended for a private deployment).
# Enter the same value in the companion's "Registration key" field.
PR_REGISTRATION_KEY=

# Pairing code lifetime in seconds (short!)
PR_PAIRING_TTL_SEC=120

# TURN (coturn "use-auth-secret"); must equal static-auth-secret in turnserver.conf
PR_TURN_SECRET=
PR_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
PR_STUN_URLS=stun:turn.example.com:3478
PR_TURN_TTL_SEC=21600
